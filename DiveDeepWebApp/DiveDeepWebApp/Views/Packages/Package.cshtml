@model PackageViewModel
@{
    ViewData["Title"] = $"{Model.Name} - Dive Deep";
    var message = TempData["Message"];

    double price = Model.packageProductsVM.Sum(x => x.Variants.First().Price);
    double discountedPrice = price * 0.80;
}

<section class="py-4 py-lg-5">
    <form class="mx-auto" style="max-width: 1200px;" method="post" asp-controller="packages" asp-action="package" asp-route-packageId="@Model.Id">
        <a class="d-inline-flex align-items-center gap-2 text-decoration-none fw-semibold mb-3" asp-controller="Home" asp-action="Index">
            <span aria-hidden="true">&larr;</span>
            Tilbage til pakker
        </a>

        <article class="card border-0 rounded-4 shadow-sm overflow-hidden mb-4 mb-lg-5">
            <div class="row g-0 align-items-stretch">
                <div class="col-12 col-md-5">
                    <div class="h-100 bg-light d-flex align-items-center justify-content-center p-4 p-lg-5" style="min-height: 320px;">
                        @if (Model.Image?.Length > 0)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(Model.Image)" class="img-fluid w-100 h-100" style="max-height: 340px; object-fit: contain;" alt="@Model.Name">
                        }
                    </div>
                </div>

                <div class="col-12 col-md-7">
                    <div class="card-body d-flex flex-column justify-content-center h-100 p-4 p-lg-5">
                        <h1 class="h2 fw-bold mb-3">@Model.Name</h1>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="text-muted lh-lg mb-4">@Model.Description</p>
                        }

                        @if (message != null)
                        {
                            <div class="bg-light border rounded-3 p-3 p-lg-4">
                                <div class="flex-grow-1">
                                    <h2 class="h5 fw-bold mb-1">@message</h2>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 pt-3">
                                <span class="badge rounded-pill bg-primary px-3 py-2">@Model.packageProductsVM.Count produkter</span>

                                <div class="text-sm-end">
                                    <span class="d-block small text-muted text-decoration-line-through">@price,- DKK</span>
                                    <span class="d-block h4 fw-bold text-primary mb-1">@discountedPrice,- DKK</span>
                                    <span class="d-block small text-muted">pr. dag</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <input type="hidden" asp-for="Id" value="@Model.Id" />
            <input type="hidden" asp-for="Name" value="@Model.Name" />
            <input type="hidden" asp-for="Description" value="@Model.Description" />
        </article>

        @if (message == null)
        {
            <div class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-2 mb-4">
                <h2 class="h3 fw-bold mb-0">Dette er inkluderet</h2>
                <p class="small text-muted mb-0">Alle produkterne nedenfor er inkluderet i pakken.</p>
            </div>

            <div class="row g-4 mb-4">
                @for (int productIndex = 0; productIndex < Model.packageProductsVM.Count; productIndex++)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        @{
                            ProductViewModel packageProduct = Model.packageProductsVM[productIndex];
                            Product product = packageProduct.Variants.First();
                            string? partialName = product switch
                            {
                                BCD => "_BCD",
                                Suit => "_Suit",
                                Tank => "_Tank",
                                Regulator => "_Regulator",
                                Mask => "_Mask",
                                Fin => "_Fin",
                                _ => null
                            };

                            byte[] productImage = product.Image?.Length > 0 ? product.Image : product.Category.Image;
                        }

                        <article class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden">
                            <div class="bg-light d-flex align-items-center justify-content-center p-4" style="height: 210px;">
                                <img src="data:image/png;base64,@Convert.ToBase64String(productImage)" class="img-fluid w-100 h-100" style="object-fit: contain;" alt="@product.Name">
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <p class="text-uppercase text-muted small fw-semibold mb-1">@product.Brand</p>
                                <h3 class="h5 fw-bold mb-2">@product.Name</h3>
                                <span class="d-block fw-semibold text-primary mb-3">@product.Price,- DKK <span class="small fw-normal text-muted">pr. dag</span></span>

                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                {
                                    <p class="small text-muted mb-0">@product.Description</p>
                                }

                                <input type="hidden" name="packageProductsVM[@productIndex].ProductName" value="@packageProduct.ProductName" />

                                @if (partialName != null)
                                {
                                    <div class="border-top mt-4 pt-4">
                                        <partial name="@partialName" for="@Model.packageProductsVM[productIndex]" />
                                    </div>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>

            <div class="border-top pt-4 pb-5">
                <div class="row g-3">
                    <div class="col-12 col-md-auto d-flex align-items-center">
                        <div>
                            <span class="d-block small text-muted text-decoration-line-through">@price,- DKK</span>
                            <span class="h5 fw-bold text-primary mb-0">@discountedPrice,- DKK <span class="small fw-normal text-muted">pr. dag</span></span>
                        </div>
                    </div>
                    <div class="col-12 col-md-auto ms-md-auto">
                        <button class="btn btn-primary rounded-pill fw-semibold w-100 px-4" type="submit">
                            Læg i kurv
                        </button>
                    </div>
                </div>
            </div>
        }
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
