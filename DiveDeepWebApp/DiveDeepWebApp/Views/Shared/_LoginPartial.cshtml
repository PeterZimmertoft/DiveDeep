<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark fw-semibold px-2" asp-controller="admin" asp-action="index">Adminpanel</a>
            </li>
        }

        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold px-2" asp-controller="bookings" asp-action="index">Mine bookinger</a>
        </li>

        <li class="nav-item">
            <span class="nav-link text-dark fw-semibold px-2">@User.Identity.Name</span>
        </li>

        <li class="nav-item">
            <form class="form-inline" asp-controller="account" asp-action="logout">
                <button id="logout" type="submit" class="nav-link text-dark fw-semibold px-2">Log ud</button>
            </form>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold px-2" asp-controller="cart" asp-action="index">Kurv</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a id="register" class="nav-link text-dark fw-semibold px-2" asp-controller="account" asp-action="register">Opret konto</a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold px-2" asp-controller="account" asp-action="login">Log ind</a>
        </li>
    }
</ul>
