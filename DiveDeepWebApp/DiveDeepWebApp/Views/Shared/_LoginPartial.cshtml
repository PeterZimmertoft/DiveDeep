@using DiveDeepWebApp.Data
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-dark fw-semibold px-2" asp-controller="admin" asp-action="index">Adminpanel</a>
            </li>
        }

        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold px-2" asp-controller="bookings" asp-action="index">Mine bookinger</a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold px-2" asp-area="Identity" asp-page="/Account/Manage/Index">@UserManager.GetUserName(User)</a>
        </li>

        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link text-dark fw-semibold px-2">Log ud</button>
            </form>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold px-2" asp-controller="cart" asp-action="index">Kurv</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a id="register" class="nav-link text-dark fw-semibold px-2" asp-area="Identity" asp-page="/Account/Register">Opret konto</a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold px-2" asp-area="Identity" asp-page="/Account/Login">Log ind</a>
        </li>
    }
</ul>
