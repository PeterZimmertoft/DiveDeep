@model ProductViewModel
@{
    List<Fin> variants = Model.Variants.OfType<Fin>().ToList();
    Fin product = variants.First();

    List<string> sizes = variants.Select(x => x.Size).Distinct().ToList();
}

<div class="d-flex flex-column gap-4">
    <div class="small bg-light rounded-3 px-3 mb-0">
        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
            <span class="text-muted fw-normal">Model</span>
            <span class="fw-semibold text-end mb-0">@product.Model</span>
        </div>
    </div>

    <div class="border-0 p-0 m-0">
        <span class="d-block h6 fw-semibold mb-2">Vælg størrelse</span>
        <div class="d-flex flex-wrap gap-2">
            @foreach (string size in sizes)
            {
                string id = $"{product.Id}-size-{size}";

                <input asp-for="Size" class="btn-check" type="radio" id="@id" value="@size">
                <label class="btn btn-sm btn-outline-primary rounded-pill fw-semibold px-3 py-1" for="@id">
                    @size
                </label>
            }
        </div>

        <span class="d-block text-danger mt-1" asp-validation-for="Size"></span>
    </div>

    <input asp-for="Thickness" type="hidden" value="N/A">
    <input asp-for="Gender" type="hidden" value="N/A">
</div>
