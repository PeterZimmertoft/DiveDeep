@model List<ProductsViewModel>
@{
    ViewData["Title"] = "Produkter - Adminpanel - Dive Deep";
}


<div class="admin-layout py-4">
    <partial name="_AdminSidebar" />

    <main class="min-width-0">
        <div class="admin-page-header">
            <div>
                <h1 class="display-6 fw-bold mb-2">Kategorier og produkter</h1>
            </div>
        </div>

        <section class="card border-0 shadow-sm admin-table-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0 admin-table admin-products-table">
                    <colgroup>
                        <col style="width: 35%" />
                        <col style="width: 25%" />
                        <col style="width: 20%" />
                        <col style="width: 20%" />
                    </colgroup>
                    
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Produkt</th>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Kategori</th>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Pris pr. dag</th>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary text-end">Handlinger</th>
                        </tr>
                    </thead>
                    
                    <tbody>
                        @{ int categoryIndex = 0; }
                        @foreach (ProductsViewModel category in Model)
                        {
                            <tr class="admin-category-row" data-category-heading="@category.CategoryName">
                                <th colspan="4" scope="rowgroup">
                                    <button type="button" class="admin-category-toggle" data-bs-toggle="collapse" data-bs-target="#category-products-@categoryIndex" aria-expanded="true" aria-controls="category-products-@categoryIndex">
                                        <span class="admin-category-label">
                                            @category.CategoryName 

                                            <span class="admin-category-count">
                                                @category.ProductsByName.Keys.Count() produkter
                                            </span>
                                        </span>
                                
                                        <span class="admin-category-chevron" aria-hidden="true"></span>
                                    </button>
                                </th>
                            </tr>

                            <tr class="admin-category-products-row">
                                <td colspan="4" class="border-0 p-0">
                                    <div id="category-products-@categoryIndex" class="collapse show">
                                        <table class="table align-middle mb-0 admin-category-products-table">
                                            <colgroup>
                                                <col style="width: 35%" />
                                                <col style="width: 25%" />
                                                <col style="width: 20%" />
                                                <col style="width: 20%" />
                                            </colgroup>
                                            <tbody>
                                                @foreach (string productName in category.ProductsByName.Keys)
                                                {
                                                    List<Product> products = category.ProductsByName[productName];
                                                    Product product = products.First();

                                                    <tr>
                                                        <td class="px-3 px-md-4 py-4 text-nowrap">
                                                            <div>
                                                                <strong>@productName</strong>
                                                                <span class="table-subtext">@product.Brand</span>
                                                            </div>
                                                        </td>

                                                        <td class="px-3 px-md-4 py-4 text-nowrap">
                                                            <span class="d-block mb-1">
                                                                @category.CategoryName
                                                            </span>
                                                        </td>

                                                        <td class="px-3 px-md-4 py-4 text-nowrap">
                                                            <span class="fw-semibold text-primary text-nowrap">@product.Price,- DKK</span>
                                                        </td>

                                                        <td class="px-3 px-md-4 py-4 text-end">
                                                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                                                @* @if (booking.StartDate > DateTime.Now)
                                                                {
                                                                    <a asp-controller="admin" asp-action="deletebooking" asp-route-bookingId="@booking.Id" onclick="return confirm('Er du sikker at du vil slette denne booking?')" class="btn btn-outline-danger btn-sm rounded-pill px-3 text-nowrap" type="button">
                                                                        Slet
                                                                    </a>

                                                                    <a asp-controller="admin" asp-action="editbooking" asp-route-bookingId="@booking.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3 text-nowrap" type="button">
                                                                        Ændre
                                                                    </a>
                                                                }

                                                                <button class="btn btn-outline-primary btn-sm rounded-pill px-3 text-nowrap" type="button" data-bs-toggle="collapse" data-bs-target="#booking-details-@booking.Id" aria-expanded="false" aria-controls="booking-details-@booking.Id">
                                                                    Vis detaljer
                                                                </button> *@
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>

                            categoryIndex++;
                        }

                        
                        @* <tr data-table-row data-search-value="aqua lung pro hd" data-category="bcd">
                            <td><div class="admin-product-name"><span class="admin-product-mark">AL</span><div><strong>Aqua Lung Pro HD</strong><span class="table-subtext">Aqua Lung</span></div></div></td>
                            <td>BCD</td><td>275 kr.</td><td>0</td><td><span class="badge bg-danger-subtle text-danger">Udsolgt</span></td>
                        </tr>
                        <tr class="admin-category-row" data-category-heading="dragter">
                            <th colspan="5" scope="rowgroup"><button type="button" class="admin-category-toggle" data-category-toggle="dragter" aria-expanded="true"><span class="admin-category-label">Dykkerdragter <span class="admin-category-count">1 produkt</span></span><span class="admin-category-chevron" aria-hidden="true">⌄</span></button></th>
                        </tr>
                        <tr data-table-row data-search-value="mares flexa 5.4.3" data-category="dragter">
                            <td><div class="admin-product-name"><span class="admin-product-mark">MF</span><div><strong>Mares Flexa 5.4.3</strong><span class="table-subtext">Mares</span></div></div></td>
                            <td>Dykkerdragter</td><td>225 kr.</td><td>3</td><td><span class="badge bg-warning-subtle text-warning-emphasis">Få på lager</span></td>
                        </tr>
                        <tr class="admin-category-row" data-category-heading="finner">
                            <th colspan="5" scope="rowgroup"><button type="button" class="admin-category-toggle" data-category-toggle="finner" aria-expanded="true"><span class="admin-category-label">Finner <span class="admin-category-count">1 produkt</span></span><span class="admin-category-chevron" aria-hidden="true">⌄</span></button></th>
                        </tr>
                        <tr data-table-row data-search-value="scubapro seawing nova" data-category="finner">
                            <td><div class="admin-product-name"><span class="admin-product-mark">SS</span><div><strong>Scubapro Seawing Nova</strong><span class="table-subtext">Scubapro</span></div></div></td>
                            <td>Finner</td><td>95 kr.</td><td>2</td><td><span class="badge bg-warning-subtle text-warning-emphasis">Få på lager</span></td>
                        </tr>
                        <tr class="admin-category-row" data-category-heading="masker">
                            <th colspan="5" scope="rowgroup"><button type="button" class="admin-category-toggle" data-category-toggle="masker" aria-expanded="true"><span class="admin-category-label">Maske/Snorkel <span class="admin-category-count">1 produkt</span></span><span class="admin-category-chevron" aria-hidden="true">⌄</span></button></th>
                        </tr>
                        <tr data-table-row data-search-value="tusa freedom hd" data-category="masker">
                            <td><div class="admin-product-name"><span class="admin-product-mark">TF</span><div><strong>TUSA Freedom HD</strong><span class="table-subtext">TUSA</span></div></div></td>
                            <td>Maske/Snorkel</td><td>65 kr.</td><td>12</td><td><span class="badge bg-success-subtle text-success">På lager</span></td>
                        </tr>
                        <tr class="admin-category-row" data-category-heading="regulatorer">
                            <th colspan="5" scope="rowgroup"><button type="button" class="admin-category-toggle" data-category-toggle="regulatorer" aria-expanded="true"><span class="admin-category-label">Regulatorsæt <span class="admin-category-count">1 produkt</span></span><span class="admin-category-chevron" aria-hidden="true">⌄</span></button></th>
                        </tr>
                        <tr data-table-row data-search-value="apeks xtx50" data-category="regulatorer">
                            <td><div class="admin-product-name"><span class="admin-product-mark">AX</span><div><strong>Apeks XTX50</strong><span class="table-subtext">Apeks</span></div></div></td>
                            <td>Regulatorsæt</td><td>185 kr.</td><td>8</td><td><span class="badge bg-success-subtle text-success">På lager</span></td>
                        </tr>
                        <tr class="d-none" data-empty-row><td colspan="5" class="text-center text-muted py-4">Ingen produkter fundet.</td></tr> *@
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
