@model List<ProductsViewModel>
@{
    ViewData["Title"] = "Produkter - Adminpanel - Dive Deep";
}


<div class="admin-layout py-4">
    <partial name="_AdminSidebar" />

    <main class="min-width-0">
        <div class="admin-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1 class="display-6 fw-bold mb-2">Kategorier og produkter</h1>
            </div>

            <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-primary rounded-pill px-4">
                <span aria-hidden="true" class="me-1">+</span>
                Opret produkt
            </a>
        </div>

        <section class="card border-0 shadow-sm admin-table-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0 admin-table admin-products-table">
                    <colgroup>
                        <col style="width: 27%" />
                        <col style="width: 18%" />
                        <col style="width: 14%" />
                        <col style="width: 14%" />
                        <col style="width: 10%" />
                        <col style="width: 17%" />
                    </colgroup>
                    
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Produkt</th>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Kategori</th>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Pris pr. dag</th>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Antal varianter</th>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Antal</th>
                            <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary text-end">Handlinger</th>
                        </tr>
                    </thead>
                    
                    <tbody>
                        @{
                            int categoryIndex = 0;
                        }

                        @foreach (ProductsViewModel category in Model)
                        {

                            <tr class="admin-category-row" data-category-heading="@category.CategoryName">
                                <th colspan="6" scope="rowgroup">
                                    <button type="button" class="admin-category-toggle" data-bs-toggle="collapse" data-bs-target="#category-products-@categoryIndex" aria-expanded="true" aria-controls="category-products-@categoryIndex">
                                        <span class="admin-category-label">
                                            @category.CategoryName 

                                            <span class="admin-category-count">
                                                @category.ProductsByName.Keys.Count() produkter
                                            </span>
                                        </span>
                                
                                        <span class="admin-category-chevron" aria-hidden="true"></span>
                                    </button>
                                </th>
                            </tr>

                            <tr class="admin-category-products-row">
                                <td colspan="6" class="border-0 p-0">
                                    <div id="category-products-@categoryIndex" class="collapse show">
                                        <table class="table align-middle mb-0 admin-category-products-table">
                                            <colgroup>
                                                <col style="width: 27%" />
                                                <col style="width: 18%" />
                                                <col style="width: 14%" />
                                                <col style="width: 14%" />
                                                <col style="width: 10%" />
                                                <col style="width: 17%" />
                                            </colgroup>
                                            
                                            <tbody>
                                                @{
                                                    int productIndex = 0;
                                                }

                                                @foreach (string productName in category.ProductsByName.Keys)
                                                {
                                                    List<Product> products = category.ProductsByName[productName];
                                                    Product product = products.First();

                                                    string variantsCollapseId = $"product-variants-{categoryIndex}-{productIndex}";
                                                    int variants = products.Count();

                                                    <tr>
                                                        <td class="px-3 px-md-4 py-4 text-nowrap">
                                                            <div>
                                                                <strong>@productName</strong>
                                                                <span class="table-subtext">@product.Brand</span>
                                                            </div>
                                                        </td>

                                                        <td class="px-3 px-md-4 py-4 text-nowrap">
                                                            <span class="d-block mb-1">
                                                                @category.CategoryName
                                                            </span>
                                                        </td>

                                                        <td class="px-3 px-md-4 py-4 text-nowrap">
                                                            <span class="fw-semibold text-primary text-nowrap">@product.Price,- DKK</span>
                                                        </td>

                                                        <td class="px-3 px-md-4 py-4 text-nowrap">
                                                            @variants
                                                            @if (variants == 1)
                                                            {
                                                                <text>variant</text>
                                                            }
                                                            else
                                                            {
                                                                <text>varianter</text>
                                                            }
                                                        </td>

                                                        <td class="px-3 px-md-4 py-4 text-nowrap">
                                                            @if (variants == 1)
                                                            {
                                                                <text>@product.Quantity</text>
                                                            }
                                                        </td>

                                                        <td class="px-3 px-md-4 py-4 text-end">
                                                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                                                @if (variants > 1)
                                                                {
                                                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 text-nowrap" type="button" data-bs-toggle="collapse" data-bs-target="#@variantsCollapseId" aria-expanded="false" aria-controls="@variantsCollapseId">
                                                                        Vis varianter
                                                                    </button>

                                                                    <a asp-controller="Admin" asp-action="DeleteProduct" asp-route-productId="@product.Id" onclick="return confirm('Er du sikker at du vil slette alle varianter på dette produkt?')" class="btn btn-outline-danger btn-sm rounded-pill px-3 text-nowrap">Slet alle varianter</a>
                                                                }
                                                                else
                                                                {
                                                                    <a asp-controller="Admin" asp-action="EditProduct" asp-route-productId="@product.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3 text-nowrap">Ændr</a>
                                                                    <a asp-controller="Admin" asp-action="DeleteProductVariant" asp-route-productId="@product.Id" onclick="return confirm('Er du sikker at du vil slette denne produkt variant?')" class="btn btn-outline-danger btn-sm rounded-pill px-3 text-nowrap">Slet</a>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>

                                                    @if (variants > 1)
                                                    {
                                                        <tr>
                                                            <td colspan="6" class="border-0 p-0 text-wrap">
                                                                <div id="@variantsCollapseId" class="collapse overflow-hidden">
                                                                    <div class="bg-light border-top px-3 px-md-4 py-4">
                                                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                                                            <h2 class="h6 fw-bold mb-0">Varianter af @productName</h2>
                                                                            <span class="small text-muted">@variants varianter</span>
                                                                        </div>

                                                                        <div class="table-responsive bg-white border rounded-3">
                                                                            <table class="table table-sm align-middle mb-0">
                                                                                <thead class="table-light">
                                                                                    <tr>
                                                                                        <th scope="col" class="px-3 px-md-4 fw-semibold text-secondary">Variant</th>
                                                                                        <th scope="col" class="px-3 px-md-4 fw-semibold text-secondary">Egenskaber</th>
                                                                                        <th scope="col" class="px-3 px-md-4 fw-semibold text-secondary">Antal</th>
                                                                                        <th scope="col" class="px-3 px-md-4 fw-semibold text-secondary text-end">Handlinger</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                
                                                                                <tbody>
                                                                                    @for (int index = 1; index <= variants; index++)
                                                                                    {
                                                                                        Product variant = products[index - 1];

                                                                                        <tr>
                                                                                            <td class="px-3 px-md-4 fw-semibold text-nowrap">Variant @index</td>

                                                                                            <td class="px-3 px-md-4 text-nowrap">
                                                                                                <div class="d-flex flex-wrap gap-2">
                                                                                                    @if (variant is BCD bcd)
                                                                                                    {
                                                                                                        <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">Størrelse @bcd.Size</span>
                                                                                                    }
                                                                                                    else if (variant is Suit suit)
                                                                                                    {
                                                                                                        <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">@suit.Gender</span>
                                                                                                        @if (suit.Thickness != "N/A")
                                                                                                        {
                                                                                                            <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">@suit.Thickness</span>
                                                                                                        }
                                                                                                        <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">Størrelse @suit.Size</span>
                                                                                                    }
                                                                                                    else if (variant is Fin fin)
                                                                                                    {
                                                                                                        <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">Størrelse @fin.Size</span>
                                                                                                    }
                                                                                                </diV>
                                                                                            </td>

                                                                                            <td class="px-3 px-md-4 fw-semibold text-nowrap">@variant.Quantity</td>

                                                                                            <td class="px-3 py-3 text-end">
                                                                                                <div class="d-flex flex-wrap justify-content-end gap-2">
                                                                                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 text-nowrap">Ændr</button>
                                                                                                    <a asp-controller="Admin" asp-action="DeleteProductVariant" asp-route-productId="@product.Id" onclick="return confirm('Er du sikker at du vil slette denne produkt variant?')" class="btn btn-outline-danger btn-sm rounded-pill px-3 text-nowrap">Slet</a>
                                                                                                </div>
                                                                                            </td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }

                                                    productIndex++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>

                            categoryIndex++;
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
