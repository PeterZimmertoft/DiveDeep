@model List<Fin>
@{
    Fin product = Model.First();
    List<string> sizes = Model.Select(x => x.Size).Distinct().ToList();
}

<div class="d-flex flex-column gap-4">
    <div class="small bg-light rounded-3 px-3 mb-0">
        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
            <span class="text-muted fw-normal">Model</span>
            <span class="fw-semibold text-end mb-0">@product.Model</span>
        </div>
    </div>

    <fieldset class="border-0 p-0 m-0">
        <legend class="h6 fw-semibold mb-2">Vælg størrelse</legend>
        <div class="d-flex flex-wrap gap-2">
            @foreach (string size in sizes)
            {
                string id = $"size-{size}";

                <input class="btn-check" type="radio" name="selectedSize" id="@id" value="@size">
                <label class="btn btn-sm btn-outline-primary rounded-pill fw-semibold px-3 py-1" for="@id">
                    @size
                </label>
            }
        </div>
    </fieldset>
</div>
