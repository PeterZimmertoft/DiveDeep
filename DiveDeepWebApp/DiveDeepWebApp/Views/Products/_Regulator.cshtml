@model ProductViewModel
@{
    List<Regulator> variants = Model.Variants.OfType<Regulator>().ToList();
    Regulator product = variants.First();
    
}

<div class="d-flex flex-column gap-4">
    <div class="small bg-light rounded-3 px-3 mb-0">
        <div class="d-flex align-items-center justify-content-between gap-3 py-2 border-bottom">
            <span class="text-muted fw-normal">Første trin</span>
            <span class="fw-semibold text-end mb-0">@product.FirstStage</span>
        </div>

        <div class="d-flex align-items-center justify-content-between gap-3 py-2 border-bottom">
            <span class="text-muted fw-normal">Andet trin</span>
            <span class="fw-semibold text-end mb-0">@product.SecondStage</span>
        </div>

        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
            <span class="text-muted fw-normal">Octopus</span>
            <span class="fw-semibold text-end mb-0">@product.Octopus</span>
        </div>
    </div>

    <input asp-for="Size" type="hidden" value="N/A">
    <input asp-for="Thickness" type="hidden" value="N/A">
    <input asp-for="Gender" type="hidden" value="N/A">
</div>
