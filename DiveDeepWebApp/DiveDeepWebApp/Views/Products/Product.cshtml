@model ProductViewModel
@{
    ProductViewModel product = Model;
    ViewData["Title"] = $"{product.Name} - Dive Deep";

    ProductVariantViewModel variant = product.Variants!.First();
    string? partialName = variant switch
    {
        BCDViewModel => "_BCD",
        SuitViewModel => "_Suit",
        TankViewModel => "_Tank",
        RegulatorViewModel => "_Regulator",
        MaskViewModel => "_Mask",
        FinViewModel => "_Fin",
        _ => null
    };

    byte[] image = product.Image.Length > 0 ? product.Image : product.Category!.Image;
    var message = TempData["Message"];
}

<section class="py-4 py-lg-5">
    <div class="mx-auto" style="max-width: 960px;">
        <a class="d-inline-flex align-items-center gap-2 text-decoration-none fw-semibold mb-3" asp-controller="products" asp-action="products" asp-route-productId="@product.Id">
            <span aria-hidden="true">&larr;</span>
            Tilbage til produkter
        </a>

        <form method="post" asp-controller="products" asp-action="product" asp-route-categoryId="@product.Category!.Id" asp-route-productId="@product.Id" class="card border-0 rounded-4 shadow-sm overflow-hidden">
            <div class="row g-0">
                <div class="col-12 col-md-5 bg-light d-flex align-items-center justify-content-center p-4 p-lg-5" style="min-height: 320px;">
                    <img src="data:image/png;base64,@Convert.ToBase64String(image)" class="img-fluid w-100 h-100" style="max-height: 340px; object-fit: contain;" alt="@product.Name">
                </div>

                <div class="col-12 col-md-7">
                    <div class="card-body d-flex flex-column h-100 p-4 p-lg-5">
                        <p class="text-uppercase text-muted small fw-semibold mb-1">@product.Brand</p>
                        <h1 class="h2 fw-bold mb-3">@product.Name</h1>

                        @if (!string.IsNullOrWhiteSpace(product.Description))
                        {
                            <p class="text-muted lh-lg mb-4">@product.Description</p>
                        }

                        @if (message != null)
                        {
                            <div class="bg-light border rounded-3 p-3 p-lg-4">
                                <div class="flex-grow-1">
                                    <h2 class="h5 fw-bold mb-1">@message</h2>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4">
                                <span class="d-block text-muted small mb-1">Pris pr. dag</span>
                                <div class="d-flex flex-wrap align-items-baseline gap-2">
                                    <span class="h4 fw-bold text-primary mb-0">@product.Price,- DKK</span>
                                </div>
                            </div>

                            <partial name="@partialName" model="@product" />

                            <div class="border-top mt-4 pt-4">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <button class="btn btn-primary rounded-pill fw-semibold w-100 py-2" type="submit">
                                            Læg i kurv
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
