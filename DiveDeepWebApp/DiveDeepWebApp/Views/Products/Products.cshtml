    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 pb-5">
    
    @foreach (var product in Model)
    {
        <a class="col btn text-start">
            
            @{
                string path = "";
                if (product is BCD)
                    path = "/bcd.png";
                else if (product is Suit)
                    path = "/suit.png";
                else if (product is Tank)
                    path = "/tank.png";
                else if (product is Regulator)
                    path = "/regulator.png";
                else if (product is Mask)
                    path = "/mask.png";
                else if (product is Fin)
                    path = "/fin.png";
            }

            <div class="card mb-3" style="height: auto;">
                <div class="row g-0">
    
                    <!-- Tekst kolonne -->
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="card-body">
                            <h5 class="card-title">@product.Brand</h5>
                            <p class="card-text">@product.Description</p>
                            @{
                                if (product is Tank)
                                {
                                    <p class="card-text">Volumen: @product.Volume L</p>
                                }
                                else if (product is Suit)
                                {
                                    <p class="card-text">Model: @product.Model </p>
                                    <p class="card-text">Type: @product.Type </p>
                                    <p class="card-text">Køn: @product.Gender </p>
                                    <p class="card-text">Størrelse: @product.Size </p>
                                    <p class="card-text">Tykkelse: @product.Thickness </p>

                                }
                                else if (product is Regulator)
                                {
                                    <p class="card-text">Trin 1: @product.FirstStage</p>
                                    <p class="card-text">Trin 2: @product.SecondStage</p>
                                    <p class="card-text">Octopus: @product.Octopus</p>
                                }
                                else if (product is Mask)
                                {
                                    <p class="card-text">Model: @product.Model</p>
                                }
                                else if (product is Fin)
                                {
                                    <p class="card-text">Model: @product.Model</p>
                                    <p class="card-text">Størrelse: @product.Size</p>
                                }
                                else if (product is BCD)
                                {
                                    <p class="card-text">Model: @product.Model</p>
                                    <p class="card-text">Størrelse: @product.Size</p>
                                }
                            }
                            <h6 class="card-text">Pris: @product.Price,- dkk</h6>
                        </div>
                    </div>

                    <!-- Billede kolonne -->
                    <div class="col-md-6">
                        <img src=@path class="img-fluid rounded-end" alt="Billede">
                    </div>

                </div>
            </div>

        </a>
        
    }
</div>


            

