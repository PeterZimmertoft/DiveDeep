@model ProductViewModel
@{
    List<Suit> variants = Model.Variants.OfType<Suit>().ToList();
    Suit product = variants.First();

    List<string> genders = variants.Select(x => x.Gender).Distinct().ToList();
    List<string> sizes = variants.Select(x => x.Size).Distinct().ToList();
    List<string> thicknesses = variants.Select(x => x.Thickness!).Distinct().ToList();
}

<div class="d-flex flex-column gap-4">
    <div class="small bg-light rounded-3 px-3 mb-0">
        <div class="d-flex align-items-center justify-content-between gap-3 py-2 border-bottom">
            <span class="text-muted fw-normal">Model</span>
            <span class="fw-semibold text-end mb-0">@product.Model</span>
        </div>

        <div class="d-flex align-items-center justify-content-between gap-3 py-2">
            <span class="text-muted fw-normal">Type</span>
            <span class="fw-semibold text-end mb-0">@product.Type</span>
        </div>
    </div>

    <div class="border-0 p-0 m-0">
        <span class="d-block h6 fw-semibold mb-2">Vælg køn</span>
        <div class="d-flex flex-wrap gap-2">
            @foreach (string gender in genders)
            {
                string id = $"gender-{gender}";

                <input asp-for="Gender" class="btn-check" type="radio" name="selectedGender" id="@id" value="@gender">
                <label class="btn btn-sm btn-outline-primary rounded-pill fw-semibold px-3 py-1" for="@id">
                    @gender
                </label>
            }
        </div>
    </div>

    <div class="border-0 p-0 m-0">
        <span class="d-block h6 fw-semibold mb-2">Vælg størrelse</span>
        <div class="d-flex flex-wrap gap-2">
            @foreach (string size in sizes)
            {
                string id = $"size-{size}";

                <input class="btn-check" type="radio" name="selectedSize" id="@id" value="@size">
                <label class="btn btn-sm btn-outline-primary rounded-pill fw-semibold px-3 py-1" for="@id">
                    @size
                </label>
            }
        </div>
    </div>

    <div class="border-0 p-0 m-0">
        <span class="d-block h6 fw-semibold mb-2">Vælg tykkelse</span>
        <div class="d-flex flex-wrap gap-2">
            @foreach (string thickness in thicknesses)
            {
                string id = $"thickness-{thickness}";

                <input class="btn-check" type="radio" name="selectedThickness" id="@id" value="@thickness" checked="@(thicknesses.Count == 1)">
                <label class="btn btn-sm btn-outline-primary rounded-pill fw-semibold px-3 py-1" for="@id">
                    @thickness
                </label>
            }
        </div>
    </div>
</div>
