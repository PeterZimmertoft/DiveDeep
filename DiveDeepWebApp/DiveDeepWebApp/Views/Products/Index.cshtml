@{
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3 pb-5">
    @foreach (Category category in Model)
    {
        
        <a class="col btn text-start" asp-area="" asp-action="Products" asp-route-category="@category.Route">
            
            @{
                string path = $"/{category.Route}.png";
            }
            <div class="card" style="height: 225px; background-image: url(@path); background-repeat:no-repeat; background-size:contain; background-position:right;">
                <div class="card-body d-flex flex-column">
                    
                    @* <img src="@path" /> *@
                    <h5 class="card-title">@category.Name</h5>
                    <p class="card-text">@category.Description</p>
                    <img src="" alt=""/>
                </div>
            </div>
        </a>
        
    }
</div>
