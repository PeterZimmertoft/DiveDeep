@{
    ViewData["Title"] = "Adgang nægtet - Dive Deep";
}

<section class="identity-page py-4 py-lg-5" aria-labelledby="access-denied-title">
    <div class="identity-simple bg-white mx-auto p-4 p-md-5 text-center">
        <div class="identity-form-heading">
            <p class="text-uppercase text-danger small fw-semibold mb-2">Adgang nægtet</p>
            <h1 id="access-denied-title" class="fw-bold">Du har ikke adgang til siden</h1>
        </div>

        <p class="text-muted mb-4">Gå tilbage til forsiden, eller log ind med en anden konto.</p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Gå til forsiden</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Log ind igen</a>
        </div>
    </div>
</section>
