@{
    ViewData["Title"] = "Adgang nægtet - Dive Deep";
}

<section class="py-4 py-lg-5" aria-labelledby="access-denied-title">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 rounded-4 shadow-sm bg-white">
                <div class="card-body p-4 p-md-5 text-center">
                    <p class="text-uppercase text-danger small fw-semibold mb-2">Adgang nægtet</p>
                    <h1 id="access-denied-title" class="h2 fw-bold mb-3">Du har ikke adgang til siden</h1>
                    <p class="text-muted mb-4">Gå tilbage til forsiden, eller log ind med en anden konto.</p>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold">Gå til forsiden</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">Log ind igen</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
