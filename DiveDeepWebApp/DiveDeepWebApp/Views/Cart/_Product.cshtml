@model CartItemViewModel
@{
    CartItem cartItem = Model.Products.First();
    Product product = cartItem.Product!;
    
    byte[] productImage = product.Image.Length > 0 ? product.Image : product.Category.Image;
    double price = product.Price * cartItem.Quantity;
}

<li class="list-group-item border-light p-3 p-md-4">
    <div class="row g-3 g-md-4 align-items-start">
        <div class="col-auto">
            <div class="bg-light rounded-4 p-2 p-md-3">
                <img src="data:image/png;base64,@Convert.ToBase64String(productImage)" alt="@product.Name" width="80" height="80" class="object-fit-contain" />
            </div>
        </div>

        <div class="col">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <p class="small fw-semibold text-muted mb-1 text-break">@product.Brand</p>
                    <h3 class="h5 fw-bold mb-2 text-break">@product.Name</h3>

                    <div class="d-flex flex-wrap gap-2">
                        @if (product is BCD bcd)
                        {
                            <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">Størrelse @bcd.Size</span>
                        }
                        else if (product is Suit suit)
                        {
                            <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">@suit.Gender</span>
                            @if (suit.Thickness != "N/A")
                            {
                                <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">@suit.Thickness</span>
                            }
                            <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">Størrelse @suit.Size</span>
                        }
                        else if (product is Fin fin)
                        {
                            <span class="badge rounded-pill bg-light text-secondary fw-normal px-3 py-2">Størrelse @fin.Size</span>
                        }
                    </div>
                </div>

                <div class="text-md-end flex-shrink-0">
                    <span class="d-block h5 fw-bold text-primary mb-1 text-nowrap">@price,- DKK</span>
                    <span class="small text-muted">pr. dag</span>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-2">
                <form class="cart-quantity-form d-flex align-items-center gap-2" asp-controller="cart" asp-action="UpdateQuantity" method="post">
                    <input type="hidden" name="Id" value="@cartItem.Id" />
                    
                    <label for="quantity-@product.Id" class="small text-muted">Antal</label>
                    <select name="Quantity" id="quantity-@product.Id" class="form-select form-select-sm w-auto rounded-3">
                        @for (int quantity = 1; quantity <= product.Quantity; quantity++)
                        {
                            <option value="@quantity" selected="@(quantity == cartItem.Quantity)">@quantity</option>
                        }
                    </select>
                </form>

                <form asp-controller="cart" asp-action="RemoveProduct" method="post">
                    <input type="hidden" name="Id" value="@cartItem.Id" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3" aria-label="Fjern @product.Name fra kurven">Fjern</button>
                </form>
            </div>

            <span class="small text-danger mt-3 mb-0" asp-validation-for="ErrorMessage"></span>
        </div>
    </div>
</li>
