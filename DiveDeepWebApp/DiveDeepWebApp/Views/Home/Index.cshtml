                    </span>

                    <img src="./snorkelSet.png" class="img-fluid h-100" style="object-fit: contain;" alt="diving set">
                </div>

                <div class="card-body p-4 d-flex flex-column">
                    <h2 class="h3 fw-bold mb-3">Komplet snorkelsæt</h2>

                    <div class="d-flex align-items-center justify-content-end mt-auto pt-3 border-top">
                        <a class="btn btn-primary rounded-pill px-4" asp-controller="products" asp-action="home" asp-route-package="SnorkelSet">Se pakken <span aria-hidden="true">→</span></a>
                    </div>
                </div>
            </div>
        </article> *@
    </div>
</section>