@{
    ViewData["Title"] = "Home Page";
}

<section class="py-4">
    <h1 class="h2 mb-0 mb-3">Vælg din pakke</h1>

    <div class="row g-3">
        <article class="col-md-7">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <div class="row g-0 h-100">
                    <div class="col-7 p-4 d-flex flex-column justify-content-center">
                        <h2 class="h4">Komplet dykkersæt</h2>
                        <p class="text-muted small mb-3">BCD · dragt · regulator · tank · finner · maske &amp; snorkel</p>
                        <a href="/products/completeSet" class="btn btn-outline-secondary btn-sm align-self-start px-3">Se pakken</a>
                    </div>
                    
                    <div class="col-5 bg-light d-flex align-items-center">
                        <img src="/divingSet.png" class="img-fluid p-3" alt="Komplet dykkersæt">
                    </div>
                </div>
            </div>
        </article>

        <article class="col-md-5">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <div class="card-body p-4 position-relative">
                    <img src="/snorkelSet.png" class="position-absolute end-0 bottom-0 opacity-50" style="width: 45%;" alt="Komplet snorkelsæt">
                    
                    <div class="position-relative" style="z-index: 1;">
                        <h2 class="h4">Komplet snorkelsæt</h2>
                        <p class="text-muted small">Maske · snorkel · finner</p>
                        <a href="/products/snorkelSet" class="btn btn-outline-dark btn-sm px-3">Se pakken</a>
                    </div>
                </div>
            </div>
        </article>
    </div>
</section>
