@model List<Package>
@{
    ViewData["Title"] = "Home Page";
}

<section class="py-4 py-lg-5">
    <div class="text-center mx-auto mb-5" style="max-width: 650px;">
        <h1 class="display-5 fw-bold mt-2 mb-3">Alt du behøver.<br />Samlet i én pakke.</h1>
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (Package package in Model)
        {
            string path = $"/{package.Route}.png";

            <article class="col-lg-5">
                <div class="card h-100 border-0 rounded-5 shadow-sm overflow-hidden bg-white">
                    <div class="position-relative d-flex align-items-center justify-content-center p-4" style="height: 245px; background: linear-gradient(145deg, #edf8fd 0%, #f8fcff 100%);">
                        <span class="badge rounded-pill bg-primary position-absolute top-0 end-0 m-3 px-3 py-2">
                            @package.Products.Count produkter
                        </span>

                        <img src="@path" class="img-fluid h-100" style="object-fit: contain;" alt="@package.Name">
                    </div>

                    <div class="card-body p-4 d-flex flex-column">
                        <h2 class="h3 fw-bold mb-3">@package.Name</h2>

                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @foreach (Product product in package.Products)
                            {
                                string productName = product switch
                                {
                                    BCD => "BCD",
                                    Suit => "Dykkerdragt",
                                    Regulator => "Regulatorsæt",
                                    Tank => "Tank",
                                    Fin => "Finner",
                                    Mask => "Maske / snorkel"
                                };

                                <span class="badge rounded-pill bg-light text-dark border fw-normal px-3 py-2">@productName</span>
                            }
                        </div>

                        <div class="d-flex align-items-center justify-content-end mt-auto pt-3 border-top">
                            <a class="btn btn-primary rounded-pill px-4">Se pakken <span aria-hidden="true">→</span></a>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
