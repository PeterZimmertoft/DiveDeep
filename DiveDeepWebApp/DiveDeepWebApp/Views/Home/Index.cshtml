@model List<Package>
@{
    ViewData["Title"] = "Dive Deep";

    
}

<section class="py-4 py-lg-5">
    <div class="mx-auto" style="max-width: 960px;">
        <h1 class="mb-4 mb-lg-5 h2 fw-bold text-center">Alt du behøver samlet i én pakke - spar 20%!</h1>

        <div class="row g-4 justify-content-center pb-5">
            @foreach (Package package in Model)
            {
                double price = package.PackageProducts.Sum(x => x.Product.Price);
                double discountedPrice = price * 0.80;

                <article class="col-12 col-md-6">
                    <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden">
                        <div class="bg-light position-relative d-flex align-items-center justify-content-center p-4" style="height: 210px;">
                            <span class="badge rounded-pill bg-primary position-absolute top-0 end-0 m-3 px-3 py-2">
                                @package.PackageProducts.Count produkter
                            </span>

                            <img src="data:image/png;base64,@Convert.ToBase64String(package.Image)" class="img-fluid h-100 w-100" style="object-fit: contain;" alt="@package.Name">
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h2 class="h5 fw-bold mb-3">@package.Name</h2>

                            <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
                                <div>
                                    <span class="d-block small text-muted text-decoration-line-through">@price,- DKK</span>
                                    <span class="d-block h5 fw-bold text-primary mb-0">@discountedPrice,- DKK</span>
                                    <span class="d-block small text-muted">pr. dag</span>
                                </div>
                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">Spar 20%</span>
                            </div>

                            <div class="mt-auto">
                                <a class="btn btn-primary rounded-pill fw-semibold w-100 py-2" asp-controller="packages" asp-action="package" asp-route-packageId="@package.Id">
                                    Se pakken <span aria-hidden="true">&rarr;</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
