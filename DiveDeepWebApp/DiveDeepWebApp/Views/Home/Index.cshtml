@model List<Package>
@{
    ViewData["Title"] = "Home Page";
}

<section class="py-4 py-lg-5">
    <div class="row g-4">
        @foreach (Package package in Model)
        {
            string path = $"/{package.Route}.png";

            <article class="col-lg-6">
                <div class="card h-100 border-0 rounded-5 shadow-sm overflow-hidden">
                    <div class="row g-0 h-100">
                        <div class="col-7 p-4 p-xl-5 d-flex flex-column align-items-start">
                            <span class="text-primary text-uppercase fw-semibold small mb-2">@package.Products.Count dele</span>
                            <h2 class="h3 fw-bold mb-2">@package.Name</h2>
                            <a class="btn btn-outline-primary rounded-pill px-4 mt-auto">Se pakken</a>
                        </div>

                        <div class="col-5 d-flex align-items-center justify-content-center" style="background: #f3f8fb;">
                            <img src="@path" class="img-fluid p-3" style="max-height: 260px; object-fit: contain;" alt="@package.Name">
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
