@{
    ViewData["Title"] = "Mine bookinger - Dive Deep";
}

<section class="pt-4 pb-5" aria-labelledby="bookings-title">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 id="bookings-title" class="display-6 fw-bold mb-2">Mine bookinger</h1>
            <p class="text-muted mb-0">Få overblik over dit udstyr og dine lejeperioder.</p>
        </div>

        <a class="btn btn-primary rounded-pill px-4 py-2 fw-semibold align-self-start align-self-md-center flex-shrink-0" asp-controller="products" asp-action="index">Find udstyr <span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="card border-0 rounded-4 bg-white shadow-sm overflow-hidden">
        <div class="table-responsive" role="region" aria-label="Bookingoversigt" tabindex="0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-nowrap">
                    <tr>
                        <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Booking</th>
                        <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Udstyr</th>
                        <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Fra</th>
                        <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Til</th>
                        <th scope="col" class="px-3 px-md-4 py-3 fw-semibold text-secondary">Status</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <th scope="row" class="px-3 px-md-4 py-4 fw-semibold text-secondary text-nowrap">#1042</th>
                        <td class="px-3 px-md-4 py-4 text-nowrap"><span class="d-block fw-semibold mb-1">Komplet dykkersæt</span><span class="small text-muted">Våddragt, maske og finner</span></td>
                        <td class="px-3 px-md-4 py-4 text-nowrap"><time class="small text-nowrap" datetime="2026-09-25">25. sep. 2026</time></td>
                        <td class="px-3 px-md-4 py-4 text-nowrap"><time class="small text-nowrap" datetime="2026-09-28">28. sep. 2026</time></td>
                        <td class="px-3 px-md-4 py-4 text-nowrap"><span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">Kommende</span></td>
                    </tr>

                    <tr>
                        <th scope="row" class="px-3 px-md-4 py-4 fw-semibold text-secondary text-nowrap">#1038</th>
                        <td class="px-3 px-md-4 py-4 text-nowrap"><span class="d-block fw-semibold mb-1">Våddragt og dykkercomputer</span><span class="small text-muted">2 produkter</span></td>
                        <td class="px-3 px-md-4 py-4 text-nowrap"><time class="small text-nowrap" datetime="2026-09-17">17. sep. 2026</time></td>
                        <td class="px-3 px-md-4 py-4 text-nowrap"><time class="small text-nowrap" datetime="2026-09-20">20. sep. 2026</time></td>
                        <td class="px-3 px-md-4 py-4 text-nowrap"><span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">I gang</span></td>
                    </tr>
                    
                    <tr>
                        <th scope="row" class="border-bottom-0 px-3 px-md-4 py-4 fw-semibold text-secondary text-nowrap">#1015</th>
                        <td class="border-bottom-0 px-3 px-md-4 py-4 text-nowrap"><span class="d-block fw-semibold mb-1">Maske og finner</span><span class="small text-muted">2 produkter</span></td>
                        <td class="border-bottom-0 px-3 px-md-4 py-4 text-nowrap"><time class="small text-nowrap" datetime="2026-08-10">10. aug. 2026</time></td>
                        <td class="border-bottom-0 px-3 px-md-4 py-4 text-nowrap"><time class="small text-nowrap" datetime="2026-08-12">12. aug. 2026</time></td>
                        <td class="border-bottom-0 px-3 px-md-4 py-4 text-nowrap"><span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary px-3 py-2">Afsluttet</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
