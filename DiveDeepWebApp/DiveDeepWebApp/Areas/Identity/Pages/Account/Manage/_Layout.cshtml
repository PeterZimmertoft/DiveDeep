@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="text-center mx-auto mb-5">
    <h1 class="display-5 fw-bold mb-1">Min konto</h1>
    <p class="lead text-muted mb-0">Opdater dine oplysninger og administrer din kontos sikkerhed.</p>
</div>

<div class="identity-manage card border-0 rounded-5 shadow-sm bg-white p-4 p-md-5">
    <div class="row g-4 g-lg-5">
        <nav class="col-lg-3" aria-label="Kontoindstillinger">
            <partial name="_ManageNav" />
        </nav>

        <div class="identity-content col-lg-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
